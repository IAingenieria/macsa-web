# Origen público del sitio. Gobierna canonical, sitemap y OpenGraph.
# Mientras viva en Cloudflare Pages debe apuntar al .pages.dev; el día del
# dominio propio se cambia SOLO esta variable.
NEXT_PUBLIC_SITE_URL=https://macsa-web.shy-block-053a.workers.dev

# Mientras sea "1" el sitio va noindex + robots Disallow: /
# Se pone en "0" el día que el dominio definitivo sirva el sitio.
NEXT_PUBLIC_NOINDEX=1

# Endpoint del CRM que recibe los prospectos. Si está vacío, el formulario
# cae a WhatsApp con el mensaje ya redactado.
NEXT_PUBLIC_LEAD_ENDPOINT=

# Prefijo de ruta. Vacio en Cloudflare (raiz); /macsa-web en GitHub Pages.
NEXT_PUBLIC_BASE_PATH=

# Widget de MacsaIA. Vacio hasta activar el canal web del bot de produccion.
# Cuando se active: https://forja-crm-69958e.<subdominio>.workers.dev/widget.js
NEXT_PUBLIC_BOT_WIDGET=
